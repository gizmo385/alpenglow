# Postgres role and database: ../postgres/create_service_db.sh vikunja
VIKUNJA_DATABASE_PASSWORD=

# Signs login sessions. Generate with: openssl rand -hex 32
VIKUNJA_SERVICE_SECRET=

# Keycloak client "vikunja" (confidential, standard flow).
# Valid redirect URI: https://board.acbc.house/auth/openid/keycloak
VIKUNJA_AUTH_OPENID_PROVIDERS_KEYCLOAK_AUTHURL=https://sso.acbc.house/realms/<realm>
VIKUNJA_AUTH_OPENID_PROVIDERS_KEYCLOAK_CLIENTID=vikunja
VIKUNJA_AUTH_OPENID_PROVIDERS_KEYCLOAK_CLIENTSECRET=

# Once a Keycloak login works, turn off Vikunja's own username/password login.
#VIKUNJA_AUTH_LOCAL_ENABLED=false
