# uid/gid of the claude-jobs user that owns the rootless job daemon (id claude-jobs)
JOBS_UID=
JOBS_GID=

# Long-lived Claude subscription token: run `claude setup-token` and paste it.
# Expires after a year.
CLAUDE_CODE_OAUTH_TOKEN=

# Shared with the Vikunja webhook (its "secret" field). openssl rand -hex 32
WEBHOOK_SECRET=

# Vikunja API token (Settings > API Tokens) with tasks and task comments access.
VIKUNJA_API_TOKEN=

# Safety limits
JOBS_PER_DAY=20
MAX_CONCURRENT_JOBS=1
