# Metadata store (dashboards, alerts, users) lives in the shared Postgres.
# Create the role/database with /services/postgres/create_service_db.sh signoz
# and URL-encode the password.
SIGNOZ_SQLSTORE_POSTGRES_DSN=postgres://signoz:<url-encoded-password>@postgres:5432/signoz?sslmode=disable

# Root user for impersonation (casting.yaml): the existing admin and org.
# The password must be that admin's current password, or SigNoz changes it.
SIGNOZ_USER_ROOT_EMAIL=
SIGNOZ_USER_ROOT_ORG_ID=
SIGNOZ_USER_ROOT_PASSWORD=
