// Grafana Alloy: the collection agent in front of SigNoz.
//
//   * Logs:    stdout/stderr of every container on the host, plus the host's
//              systemd journal (sshd, sudo, kernel/UFW, cron, ...).
//   * Metrics: scraped from containers labelled prometheus.io/scrape=true.
//   * OTLP:    traces/metrics/logs pushed by instrumented services to
//              signoz-alloy:4317 (gRPC) or :4318 (HTTP) on the caddy network.
//
// Everything is converted to OTLP and sent to the SigNoz ingester. See the
// "Container identity" section for how service.name is derived.
//
// Docker access goes through /services/docker-proxy (docker-read-logs profile).
//
// Pipeline status and discovered targets: https://alloy.alpenglow.acbc.house

discovery.docker "containers" {
  host = "tcp://docker-proxy:2375"
}

// ---------------------------------------------------------------------------
// Logs
// ---------------------------------------------------------------------------

discovery.relabel "docker_logs" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*?)(?:-[0-9]+)?"
    target_label  = "service_name"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
}

loki.source.docker "containers" {
  host          = "tcp://docker-proxy:2375"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.docker_logs.rules
  forward_to    = [otelcol.receiver.loki.docker_logs.receiver]
}

otelcol.receiver.loki "docker_logs" {
  output {
    logs = [otelcol.processor.transform.containers.input]
  }
}

// ---------------------------------------------------------------------------
// Host journal
//
// Lands as service.namespace "host" with service.name set to the syslog
// identifier (sshd, sudo, kernel, CRON, ...), so it never collides with a
// container's logs. Journal priority becomes the log severity.
// ---------------------------------------------------------------------------

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label  = "syslog_identifier"
  }
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "systemd_unit"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "priority"
  }
}

loki.source.journal "host" {
  path          = "/var/log/journal"
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.process.journal.receiver]
}

loki.process "journal" {
  // tailscaled logs ~17k lines a day of connection chatter at info level;
  // keep only its warnings and errors.
  stage.match {
    selector = "{syslog_identifier=\"tailscaled\", priority=~\"info|notice|debug\"}"
    action   = "drop"
  }

  forward_to = [otelcol.receiver.loki.journal.receiver]
}

otelcol.receiver.loki "journal" {
  output {
    logs = [otelcol.processor.transform.journal.input]
  }
}

otelcol.processor.transform "journal" {
  error_mode = "ignore"

  log_statements {
    context    = "log"
    statements = [
      `set(resource.attributes["service.namespace"], "host")`,
      `set(resource.attributes["service.name"], attributes["syslog_identifier"]) where attributes["syslog_identifier"] != nil`,
      `set(resource.attributes["service.name"], "journal") where attributes["syslog_identifier"] == nil`,
      `set(attributes["systemd.unit"], attributes["systemd_unit"]) where attributes["systemd_unit"] != nil`,
      `set(severity_text, "FATAL") where attributes["priority"] == "emerg" or attributes["priority"] == "alert" or attributes["priority"] == "crit"`,
      `set(severity_text, "ERROR") where attributes["priority"] == "err"`,
      `set(severity_text, "WARN") where attributes["priority"] == "warning"`,
      `set(severity_text, "INFO") where attributes["priority"] == "notice" or attributes["priority"] == "info"`,
      `set(severity_text, "DEBUG") where attributes["priority"] == "debug"`,
      `set(severity_number, SEVERITY_NUMBER_FATAL) where severity_text == "FATAL"`,
      `set(severity_number, SEVERITY_NUMBER_ERROR) where severity_text == "ERROR"`,
      `set(severity_number, SEVERITY_NUMBER_WARN) where severity_text == "WARN"`,
      `set(severity_number, SEVERITY_NUMBER_INFO) where severity_text == "INFO"`,
      `set(severity_number, SEVERITY_NUMBER_DEBUG) where severity_text == "DEBUG"`,
      `delete_matching_keys(attributes, "^(syslog_identifier|systemd_unit|priority|loki\\.attribute\\.labels)$")`,
    ]
  }

  output {
    logs = [otelcol.processor.batch.default.input]
  }
}

// ---------------------------------------------------------------------------
// Metrics: opt in per container with Prometheus' conventional labels
//
//   labels:
//     prometheus.io/scrape: "true"
//     prometheus.io/port: "9000"
//     prometheus.io/path: "/metrics"   # optional, defaults to /metrics
//
// The container must be on the caddy network, which Alloy shares.
// ---------------------------------------------------------------------------

discovery.relabel "scrape_targets" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_prometheus_io_scrape"]
    regex         = "true"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_network_name"]
    regex         = "caddy"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_network_ip", "__meta_docker_container_label_prometheus_io_port"]
    regex         = "(.+);(.+)"
    replacement   = "$1:$2"
    target_label  = "__address__"
  }
  rule {
    source_labels = ["__meta_docker_container_label_prometheus_io_path"]
    regex         = "(.+)"
    target_label  = "__metrics_path__"
  }
  // otelcol.receiver.prometheus maps job -> service.name.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*?)(?:-[0-9]+)?"
    target_label  = "job"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "instance"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
}

prometheus.scrape "containers" {
  targets         = discovery.relabel.scrape_targets.output
  scrape_interval = "30s"
  // Pass metric types on to otelcol.receiver.prometheus; without them every
  // counter and histogram arrives in SigNoz as a plain gauge. Experimental,
  // hence --stability.level=experimental in compose.yaml.
  honor_metadata  = true
  forward_to      = [otelcol.receiver.prometheus.default.receiver]
}

otelcol.receiver.prometheus "default" {
  output {
    metrics = [otelcol.processor.transform.containers.input]
  }
}

// ---------------------------------------------------------------------------
// Container identity for logs, scraped metrics and OBI traces
//
//   service.name       container name minus compose's replica suffix, except
//                      that "<svc>-<svc>" collapses to "<svc>"
//                      (keycloak-keycloak-1 -> keycloak, tandoor-web_recipes-1
//                      -> tandoor-web_recipes, immich_server -> immich_server)
//   service.namespace  compose project (logs and metrics only; OBI doesn't
//                      report it)
//
// The rule only needs the container name and compose service, both of which
// OBI traces carry too (OBI names services after the compose service), so all
// three signals agree and SigNoz can correlate them. Apps that export their
// own OTLP (no container.name) keep the name they report.
//
// Loki entries each become their own resource and scraped resources are per
// target, so setting resource attributes from per-record labels is safe.
// ---------------------------------------------------------------------------

otelcol.processor.transform "containers" {
  error_mode = "ignore"

  log_statements {
    context    = "log"
    statements = [
      `set(resource.attributes["container.name"], attributes["container"])`,
      `set(resource.attributes["service.name"], attributes["service_name"])`,
      `set(resource.attributes["service.name"], attributes["compose_service"]) where attributes["compose_service"] != nil and attributes["service_name"] == Concat([attributes["compose_service"], attributes["compose_service"]], "-")`,
      `set(resource.attributes["service.namespace"], attributes["compose_project"]) where attributes["compose_project"] != nil`,
      `delete_matching_keys(attributes, "^(container|service_name|compose_project|compose_service|loki\\.attribute\\.labels)$")`,
    ]
  }

  // otelcol.receiver.prometheus already set service.name from the job label
  // (the suffix-stripped container name).
  metric_statements {
    context    = "datapoint"
    statements = [
      `set(resource.attributes["service.name"], attributes["compose_service"]) where attributes["compose_service"] != nil and resource.attributes["service.name"] == Concat([attributes["compose_service"], attributes["compose_service"]], "-")`,
      `set(resource.attributes["service.namespace"], attributes["compose_project"]) where attributes["compose_project"] != nil`,
      `delete_matching_keys(attributes, "^compose_(project|service)$")`,
    ]
  }

  // OBI sets service.name to the compose service (or the process's
  // OTEL_SERVICE_NAME) and container.name to the container.
  trace_statements {
    context    = "resource"
    statements = [
      `set(cache["base"], attributes["container.name"]) where attributes["container.name"] != nil`,
      `replace_pattern(cache["base"], "-[0-9]+$", "") where cache["base"] != nil`,
      `set(attributes["service.name"], cache["base"]) where cache["base"] != nil and cache["base"] != Concat([attributes["service.name"], attributes["service.name"]], "-")`,
    ]
  }

  output {
    logs    = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

// ---------------------------------------------------------------------------
// OTLP from instrumented services
// ---------------------------------------------------------------------------

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.transform.containers.input]
  }
}

// ---------------------------------------------------------------------------
// Export to SigNoz
// ---------------------------------------------------------------------------

otelcol.processor.batch "default" {
  output {
    metrics = [otelcol.exporter.otlp.signoz.input]
    logs    = [otelcol.exporter.otlp.signoz.input]
    traces  = [otelcol.exporter.otlp.signoz.input]
  }
}

otelcol.exporter.otlp "signoz" {
  client {
    endpoint = "signoz-ingester:4317"
    tls {
      insecure = true
    }
  }
}
