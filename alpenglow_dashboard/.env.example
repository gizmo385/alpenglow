# Copy to .env and fill in. Committed example — no real secrets here.

# ── runtime flags ──
# Serve fixture data instead of live integrations (A1 mock mode).
MOCK_DATA=1
# Bypass the forwarded-header auth (local dev ONLY — never in production).
DEV_NO_AUTH=0
# Group (from X-Forwarded-Groups) required for mutating requests.
# Keycloak group is "Admin" (forwarded as "/Admin"; backend strips the slash).
ADMIN_GROUP=Admin

# ── integration base URLs (reachable over the caddy docker network) ──
GLANCES_URL=http://glances:61208
UPTIME_KUMA_URL=http://uptime_kuma:3001
UPTIME_KUMA_API_KEY=
# Browser-facing Kuma UI, used for the Monitors tile's external-link affordance
# (falls back to this default if unset).
KUMA_PUBLIC_URL=https://uptime.alpenglow.acbc.house
BESZEL_URL=http://beszel:8090
UPDATES_TRACKER_URL=http://updates-tracker-release-feeds-1:8585

# SSO status is user-maintained via tags (F1) — no Keycloak scan credentials are
# needed by the dashboard. (The oauth2-proxy sidecar still authenticates the app
# itself; its config lives in .proxy_env, not here.)
