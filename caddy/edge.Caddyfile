{
    debug
    # Localhost only: the admin API is unauthenticated and this runs on the
    # host network, where every container and tailnet device could reach it.
    admin localhost:2020

    layer4 {
        :11443 {
            route {
                proxy {
                    proxy_protocol v2
                    upstream localhost:10443
                }
            }
        }
    }
}
