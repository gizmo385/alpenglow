{
	# per_host adds a `host` label so SigNoz can break traffic down by site.
	metrics {
		per_host
	}
	# Access logs go to stdout (collected by Alloy into SigNoz) and to
	# /var/log/caddy on the host, which CrowdSec reads. Each site below opts in
	# with `log`; these loggers pick the entries up.
	log access_stdout {
		output stdout
		include http.log.access
		format json
	}
	log access_file {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
		}
		include http.log.access
		format json
	}
	# Localhost only: the admin API is unauthenticated and this container holds
	# the docker socket. docker-proxy pushes config to localhost:2019 itself.
	admin localhost:2019
	servers {
		trusted_proxies static private_ranges
	}

	servers :10443 {
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				allow 10.0.3.1/32
			}
			tls
		}
	}

	# Global TLS Options
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	acme_dns cloudflare {
		zone_token {env.CF_ZONE_TOKEN}
		api_token {env.CF_API_TOKEN}
	}
}

# Prometheus metrics for SigNoz's Alloy agent, served apart from the admin API.
http://:9180 {
	metrics
}

# Turn on access logging for every site. caddy-docker-proxy merges these with
# the label-generated blocks of the same address, so the list has to match the
# addresses used in container labels (see Caddyfile.autosave in the container).
*.acbc.house {
	log
}

*.acbc.house:10443 {
	log
}

*.alpenglow.acbc.house {
	log
}

*.alpenglow.acbc.house:10443 {
	log
}

*.internal.acbc.house {
	log
}

acbc.house {
	log
}
